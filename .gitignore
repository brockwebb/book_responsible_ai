# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# MyST build output
book/_build/
_build/

# Book exports (large generated PDFs, rebuilt from source)
book/exports/*.pdf

# Environment
.env
.env.local

# Seldon — seldon.yaml and seldon_events.jsonl ARE tracked (the event log is the
# source of truth that `seldon rebuild` replays into Neo4j). Only local session
# state and regenerated output are ignored.
.seldon/
# Regenerated by every `seldon verify`. Lands at the repo root because it is
# written to paths.book's parent. Here it is all "unused terms" — the shared
# validity ontology is a research vocabulary this satire will never draw on.
keyword_index.md

# Claude Code
.claude/

# Session artifacts (not for public repo)
cc_tasks/
handoffs/
audits/

# Old/rejected art variants — not used in the book, not tracked
arc/

# Local master art corpus — NOT published content. Lossless originals kept in
# case resolution/re-encoding work is ever redone. book/images/ is the only
# committed art (derived, web/PDF-weight copies). Art changes touch
# book/images/ only; regenerate from these masters when needed.
assets/

# Working docs (not for public repo)
/docs/

# IDE
.vscode/
.idea/

# Node
node_modules/
