book/exports/*.pdf

# Environment
.env
.env.local

# Seldon — seldon.yaml and seldon_events.jsonl ARE tracked (the event log is the
# source of truth that `seldon rebuild` replays into Neo4j). Only local session
# state and regenerated output are ignored.
.seldon/
# Regenerated by every `seldon verify`. Lands at the repo root because it is
# written to paths.book's parent. Here it is all "unused terms" — the shared
# validity ontology is a research vocabulary this satire will never draw on.
keyword_index.md

# Claude Code
.claude/

# Session artifacts (not for public repo)
cc_tasks/
handoffs/
audits/

# Old/rejected art variants — not used in the book, not tracked
arc/

# Working docs (not for public repo)
/docs/

# IDE
.vscode/
.idea/

# Node
node_modules/
